\examples{
# Small hierarchy: Total = A + B, A = A1 + A2, B = B1 + B2
S <- rbind(c(1,1,1,1),c(1,1,0,0),c(0,0,1,1),diag(4))
rownames(S) <- c("Total","A","B","A1","A2","B1","B2")
set.seed(1)
b <- matrix(rnorm(40,10),10,4)
y <- b \%*\% t(S)
colnames(y) <- rownames(S)

# Add discrepancies at Total and A
y[,"Total"] <- y[,"Total"] + rnorm(10)
y[,"A"] <- y[,"A"] + rnorm(10)
aug <- Saugment(S,ts(y,frequency=4),outplot=TRUE)
aug$status
aug$S

# Block view, passing arguments to plotS
aug <- Saugment(S,y,outplot=TRUE,view="block")

# Total is published as A + B, while A and B differ from their bottom level
# series. The discrepancy of Total is then the sum of those of A and B.
y <- b \%*\% t(S)
colnames(y) <- rownames(S)
y[,"A"] <- y[,"A"] + rnorm(10)
y[,"B"] <- y[,"B"] + rnorm(10)
y[,"Total"] <- y[,"A"] + y[,"B"]

# By default A and B get their own discrepancy series and Total is implied
Saugment(S,y)$status

# Use nodes to give Total its own discrepancy series instead. B is now implied
# as the difference between the discrepancies of Total and A
aug <- Saugment(S,y,nodes="Total")
aug$status
aug$D

# Short sample: a temporal hierarchy of a seasonal series together with its
# seasonally adjusted version, with only 5 years of data. The discrepancies of the
# adjusted aggregates are sums of those of the adjusted months, following S.
y <- ts(100 + 10*sin(2*pi*(1:60)/12) + rnorm(60),frequency=12)
s <- stl(y,s.window=7)$time.series[,"seasonal"]
Sn <- Sthief(y)
rownames(Sn) <- paste0("n",1:nrow(Sn))
S2 <- rbind(Sn,Sn)
rownames(S2) <- c(paste0("NSA.",rownames(Sn)),paste0("SA.",rownames(Sn)))
stack <- function(x){matrix(x,ncol=12,byrow=TRUE) \%*\% t(Sn)}
Y <- cbind(stack(y),stack(y-s))
colnames(Y) <- rownames(S2)
aug <- Saugment(S2,Y)
table(aug$status)

# The same structure given explicitly with D
D <- Sn
dimnames(D) <- list(paste0("SA.",rownames(Sn)),paste0("SA.n",17:28))
aug <- Saugment(S2,Y,D=D)
table(aug$status)

}
